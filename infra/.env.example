# 로컬 개발용 기본값 예시. 복사해서 사용:  cp .env.example .env
# .env 는 .gitignore 로 커밋되지 않는다. 운영 비밀값은 절대 여기에 두지 않는다.

# --- PostgreSQL ---
POSTGRES_DB=koitda
POSTGRES_USER=koitda
POSTGRES_PASSWORD=koitda_local_pw
POSTGRES_PORT=5432

# --- MinIO (S3 호환 객체 저장소) ---
MINIO_ROOT_USER=koitda
MINIO_ROOT_PASSWORD=koitda_local_pw
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# 애플리케이션이 사용할 버킷 이름 (백엔드 기동 시 없으면 생성)
KOITDA_S3_BUCKET=koitda-assets
